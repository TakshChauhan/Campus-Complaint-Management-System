# Copy to frontend/.env for local development:  cp .env.example .env
# Vite exposes only VITE_* variables, and every value here is PUBLIC (bundled into the JS).
# Never put secrets in this file.

# Backend ORIGIN (no /api/v1 — the API client adds it).
VITE_API_BASE_URL=http://localhost:8000

# Show the Google sign-in button. Set to true ONLY when the backend has
# GOOGLE_AUTH_ENABLED=True and a configured Google OAuth client.
VITE_GOOGLE_AUTH_ENABLED=false

# Domains shown in the registration hint (the backend enforces ALLOWED_EMAIL_DOMAINS).
VITE_ALLOWED_EMAIL_DOMAINS=dau.ac.in,daiict.ac.in
