# ==============================================================================
# CCMS Docker Compose Environment Configuration
# Copy this file to .env before starting containers:
#   cp .env.docker.example .env
# ==============================================================================

# PostgreSQL Database Configuration
POSTGRES_USER=ccms_user
POSTGRES_PASSWORD=change_this_secure_password_in_production
POSTGRES_DB=ccms_db
POSTGRES_PORT=5432

# Backend Application Configuration
SECRET_KEY=generate_a_random_32_character_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
PORT=8000

# CORS Origins (Comma-separated URLs)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000

# Environment Mode
ENVIRONMENT=production
DEBUG=false
