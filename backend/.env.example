# ==============================================================================
# Campus Complaint Management System (CCMS) - Backend Environment Configuration
# Copy this file to .env in the backend/ directory for local development:
#   cp .env.example .env
# ==============================================================================

# Application Meta
PROJECT_NAME="Campus Complaint Management System (CCMS)"
ENVIRONMENT=development
DEBUG=True

# Database Configuration (PostgreSQL in production/staging, SQLite for local dev/testing)
# Local SQLite example:
#   DATABASE_URL=sqlite:///./ccms.db
# Local PostgreSQL example:
#   DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ccms_db
DATABASE_URL=sqlite:///./ccms.db

# Bounded connection pool settings (per backend worker)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Security & JWT Authentication
# IMPORTANT: Generate a strong secret key (min 32 characters) for staging/production!
# Example generator: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=dev-insecure-jwt-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed CORS Origins (comma-separated list for frontend dev servers).
# In ENVIRONMENT=production, localhost origins are rejected at startup.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Institutional email-domain policy (password registration, and first-time Google
# sign-in when GOOGLE_ALLOWED_HOSTED_DOMAINS is empty). Comma-separated.
# NOTE: accepting an address on these domains does NOT prove the student owns it;
# email ownership verification needs an email delivery service (see README, Sprint 2).
ALLOWED_EMAIL_DOMAINS=dau.ac.in,daiict.ac.in

# Google OAuth 2.0 / OpenID Connect (OIDC) Authentication
# Set to True to enable the Google Sign-In button and handoff endpoints
GOOGLE_AUTH_ENABLED=False
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
# Allowed Google Workspace hosted domains (matches signed 'hd' claim).
# Leave empty to allow any verified Google account, or specify comma-separated domains (e.g. dau.ac.in,daiict.ac.in)
GOOGLE_ALLOWED_HOSTED_DOMAINS=dau.ac.in,daiict.ac.in
# Dedicated encryption key for server-side PKCE state (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
GOOGLE_OAUTH_ENCRYPTION_KEY=


# Optional Development User Seeding (STRICTLY FOR DEVELOPMENT/TESTING ONLY)
# Never enable demo account seeding in production environments!
ALLOW_DEMO_SEEDING=False
DEV_ADMIN_EMAIL=admin@campus.edu
DEV_ADMIN_PASSWORD=AdminSecret123!
DEV_STAFF_EMAIL=staff.it@campus.edu
DEV_STAFF_PASSWORD=StaffSecret123!

# Registration now requires a verifiable email. Use Resend with a verified sending
# domain for real users or SMTP with Mailpit (port 1025) for local test emails.
# The mock provider does not deliver mail; do not use it for real accounts.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM="CCMS Campus Portal <onboarding@resend.dev>"
EMAIL_VERIFICATION_URL=http://localhost:5173/verify-email
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=30
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
