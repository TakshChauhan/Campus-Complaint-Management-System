# ==============================================================================
# CCMS - Production Environment Configuration Template
# ==============================================================================

# Core Application Settings
PROJECT_NAME="Campus Complaint Management System (CCMS)"
ENVIRONMENT=production
DEBUG=False
ENABLE_API_DOCS=False

# Database Configuration (PostgreSQL / Supabase)
# ==============================================================================
# IMPORTANT: Production PostgreSQL connections REQUIRE explicit TLS (sslmode=require).
# If your database password contains special characters (like '#', '@', ':'),
# percent-encode them (e.g. '#' becomes '%23', '@' becomes '%40').
#
# Option A: Direct Connection (Direct IPv6/IPv4 connection, Port 5432):
#   DATABASE_URL=postgresql+psycopg://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require
#
# Option B: Session Pooler (IPv4-compatible via PgBouncer session mode, Port 5432):
#   DATABASE_URL=postgresql+psycopg://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
#
# Option C: Transaction Pooler (IPv4-compatible via PgBouncer transaction mode, Port 6543):
#   NOTE: Transaction pooler mode does not support session-level prepared statements.
#   DATABASE_URL=postgresql+psycopg://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
# ==============================================================================
DATABASE_URL=postgresql+psycopg://postgres:[ENCODED_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require

# Connection Pool Settings (per server worker)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Security & JWT Authentication
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-cryptographically-secure-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed CORS Origins (Comma-separated list of deployed frontend origins; NO WILDCARDS)
CORS_ORIGINS=https://your-frontend.vercel.app

# Email Domain Restriction for Password Registration
ALLOWED_EMAIL_DOMAINS=dau.ac.in,daiict.ac.in

# Google OAuth 2.0 / OpenID Connect (OIDC) Authentication
GOOGLE_AUTH_ENABLED=True
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret
GOOGLE_OAUTH_REDIRECT_URI=https://your-backend-api.onrender.com/api/v1/auth/google/callback
# Restrict to verified university Google Workspace hosted domains (signed 'hd' claim)
GOOGLE_ALLOWED_HOSTED_DOMAINS=dau.ac.in,daiict.ac.in
# Dedicated encryption key for server-side PKCE state (python -c "import secrets; print(secrets.token_urlsafe(32))")
GOOGLE_OAUTH_ENCRYPTION_KEY=replace-with-a-dedicated-32-byte-base64-encryption-key


# Production Demo Accounts (DISABLED)
# Demo accounts must NEVER be enabled in production environments!
ALLOW_DEMO_SEEDING=False
